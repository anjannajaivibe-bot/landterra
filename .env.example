# ==========================================
# LandTerra - Real Estate Marketplace Configuration
# ==========================================

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/landmarketplace?retryWrites=true&w=majority"

# Authentication & Session
AUTH_SECRET="your-32-character-random-auth-secret-string"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Maps Platform (Maps JavaScript API, Places API, Geocoding API)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="landterra-assets"
R2_PUBLIC_URL="https://pub-yourbucket.r2.dev"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourkeyid"

# Resend Email Service
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="LandTerra <notifications@landterra.com>"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin Portal Security
ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"
ADMIN_SECRET_KEY="super_secure_admin_passcode_change_me"

# OTP Provider Configuration (Twilio / Fast2SMS / Generic Webhook)
OTP_PROVIDER="test" # "twilio" | "fast2sms" | "test"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""

